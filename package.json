{
  "name": "aspen",
  "private": true,
  "version": "0.4.3",
  "description": "Native FPGA desktop workbench for the FDE platform.",
  "author": "0xtaruhi",
  "homepage": "https://github.com/0xtaruhi/aspen",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xtaruhi/aspen.git"
  },
  "bugs": {
    "url": "https://github.com/0xtaruhi/aspen/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "prepare:tauri-build": "node scripts/prepare-tauri-build.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests",
    "generate:zh-tw-locale": "node scripts/generate-zh-tw-locale.mjs",
    "generate:zh-tw-manuals": "node scripts/generate-zh-tw-manuals.mjs",
    "generate:icons": "bash scripts/generate-app-icon.sh",
    "prepare:slang-server-bundle": "node scripts/prepare-slang-server-bundle.mjs",
    "prepare:yosys-bundle": "node scripts/prepare-yosys-bundle.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/vue-table": "^8.21.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.11",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.5",
    "monaco-editor": "^0.55.1",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vue3-grid-layout": "^1.0.0",
    "wavedrom": "^3.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "opencc-js": "^1.4.0",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,vue,json,css,scss,md,yml,yaml}": "prettier --write",
    "src-tauri/src/**/*.rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --"
  }
}
